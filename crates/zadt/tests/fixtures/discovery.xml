<?xml version="1.0" encoding="utf-8"?>
<app:service
    xmlns:app="http://www.w3.org/2007/app"
    xmlns:atom="http://www.w3.org/2005/Atom">
    <app:workspace>
        <atom:title>Programme</atom:title>
        <app:collection href="/sap/bc/adt/programs/includes">
            <atom:title>Includes</atom:title>
            <app:accept>application/vnd.sap.adt.programs.includes.v2+xml</app:accept>
            <atom:category
                term="includes"
                scheme="http://www.sap.com/adt/categories/programs" />
        </app:collection>
        <app:collection href="/sap/bc/adt/programs/programs">
            <atom:title>Programs</atom:title>
            <app:accept>application/vnd.sap.adt.programs.programs.v2+xml</app:accept>
            <app:accept>application/vnd.sap.adt.programs.programs.v3+xml</app:accept>
            <atom:category
                term="programs"
                scheme="http://www.sap.com/adt/categories/programs" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/adt/categories/programs/valuehelp/application"
                    template="/sap/bc/adt/programs/programs/{programname}/valuehelp/application" />
            </adtcomp:templateLinks>
        </app:collection>
        <app:collection href="/sap/bc/adt/programs/programrun">
            <atom:title>Run Program</atom:title>
            <atom:category
                term="programrun"
                scheme="http://www.sap.com/adt/categories/programs" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/adt/relations/programs/programrun"
                    template="/sap/bc/adt/programs/programrun/{programname}{?profilerId}"
                    type="text/plain" />
            </adtcomp:templateLinks>
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>Packages</atom:title>
        <app:collection href="/sap/bc/adt/packages">
            <atom:title>Package</atom:title>
            <app:accept>application/vnd.sap.adt.packages.v2+xml</app:accept>
            <app:accept>application/vnd.sap.adt.packages.v1+xml</app:accept>
            <atom:category
                term="devck"
                scheme="http://www.sap.com/wbobj/packages" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/wbobj/packages/devck/properties"
                    template="/sap/bc/adt/packages/{object_name}{?corrNr,lockHandle,version,accessMode,_action}" />
                <adtcomp:templateLink
                    rel="tree"
                    template="/sap/bc/adt/packages/$tree{?packagename,type}" />
            </adtcomp:templateLinks>
        </app:collection>
        <app:collection href="/sap/bc/adt/packages/settings">
            <atom:title>Package Settings</atom:title>
            <atom:category
                term="settings"
                scheme="http://www.sap.com/wbobj/packages" />
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>Object Oriented Programming</atom:title>
        <app:collection href="/sap/bc/adt/oo/classes">
            <atom:title>Classes</atom:title>
            <app:accept>application/vnd.sap.adt.oo.classes.v2+xml</app:accept>
            <app:accept>application/vnd.sap.adt.oo.classes.v3+xml</app:accept>
            <app:accept>application/vnd.sap.adt.oo.classes.v4+xml</app:accept>
            <atom:category
                term="classes"
                scheme="http://www.sap.com/adt/categories/oo" />
        </app:collection>
        <app:collection href="/sap/bc/adt/oo/interfaces">
            <atom:title>Interfaces</atom:title>
            <app:accept>application/vnd.sap.adt.oo.interfaces.v4+xml</app:accept>
            <app:accept>application/vnd.sap.adt.oo.interfaces.v5+xml</app:accept>
            <atom:category
                term="interfaces"
                scheme="http://www.sap.com/adt/categories/oo" />
        </app:collection>
        <app:collection href="/sap/bc/adt/oo/classrun">
            <atom:title>Run a class</atom:title>
            <atom:category
                term="classrun"
                scheme="http://www.sap.com/adt/categories/oo" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/adt/relations/oo/classrun"
                    template="/sap/bc/adt/oo/classrun/{classname}{?profilerId}"
                    type="text/plain" />
            </adtcomp:templateLinks>
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>Change and Transport System</atom:title>
        <app:collection href="/sap/bc/adt/cts/transports">
            <atom:title>Transports</atom:title>
            <app:accept>application/vnd.sap.as+xml;charset=utf-8;dataname=com.sap.adt.transport.service.checkData</app:accept>
            <app:accept>application/vnd.sap.as+xml; charset=UTF-8; dataname=com.sap.adt.CreateCorrectionRequest</app:accept>
            <app:accept>application/vnd.sap.as+xml; charset=UTF-8; dataname=com.sap.adt.CreateCorrectionRequest.v1</app:accept>
            <atom:category
                term="transports"
                scheme="http://www.sap.com/adt/categories/cts" />
        </app:collection>
        <app:collection href="/sap/bc/adt/cts/transportchecks">
            <atom:title>Transport Checks</atom:title>
            <atom:category
                term="transportchecks"
                scheme="http://www.sap.com/adt/categories/cts" />
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>Repository Information</atom:title>
        <app:collection href="/sap/bc/adt/repository/informationsystem/virtualfolders/contents">
            <atom:title>Virtual Folders Contents</atom:title>
            <app:accept>application/vnd.sap.adt.repository.virtualfolders.result.v1+xml</app:accept>
            <atom:category
                term="contents"
                scheme="http://www.sap.com/adt/categories/repository/virtualfolders" />
        </app:collection>
        <app:collection href="/sap/bc/adt/repository/informationsystem/virtualfolders/facets">
            <atom:title>Facets supported by Virtual Folders</atom:title>
            <atom:category
                term="facets"
                scheme="http://www.sap.com/adt/categories/repository/virtualfolders" />
        </app:collection>
        <app:collection href="/sap/bc/adt/repository/informationsystem/objectproperties/values">
            <atom:title>Object Properties</atom:title>
            <atom:category
                term="objectProperties"
                scheme="http://www.sap.com/adt/categories/repository" />
        </app:collection>
        <app:collection href="/sap/bc/adt/repository/objectstructure">
            <atom:title>Object Structure</atom:title>
            <atom:category
                term="objectstructure"
                scheme="http://www.sap.com/adt/categories/respository" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility" />
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>ABAP Dictionary</atom:title>
        <app:collection href="/sap/bc/adt/ddic/dataelements">
            <atom:title>Data Elements</atom:title>
            <app:accept>application/vnd.sap.adt.dataelements.v2+xml</app:accept>
            <atom:category
                term="dtelde"
                scheme="http://www.sap.com/wbobj/dictionary" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/wbobj/dictionary/dtelde/properties"
                    template="/sap/bc/adt/ddic/dataelements/{object_name}{?corrNr,lockHandle,version,accessMode,_action}" />
            </adtcomp:templateLinks>
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>ABAP DDL Sources</atom:title>
        <app:collection href="/sap/bc/adt/ddic/ddl/sources">
            <atom:title>DDL Sources</atom:title>
            <app:accept>application/vnd.sap.adt.ddlSource+xml</app:accept>
            <atom:category
                term="ddlsources"
                scheme="http://www.sap.com/adt/categories/ddic/ddlsources" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/adt/categories/ddic/ddlsources/properties"
                    template="/sap/bc/adt/ddic/ddl/sources/{object_name}{?corrNr,lockHandle,version,accessMode,_action}" />
                <adtcomp:templateLink
                    rel="http://www.sap.com/adt/categories/ddic/ddlsources/source"
                    template="/sap/bc/adt/ddic/ddl/sources/{object_name}/source/main{?corrNr,lockHandle,version}" />
            </adtcomp:templateLinks>
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>ABAP DCL Sources</atom:title>
        <app:collection href="/sap/bc/adt/acm/dcl/sources">
            <atom:title>DCL Sources</atom:title>
            <app:accept>application/vnd.sap.adt.dclSource+xml</app:accept>
            <atom:category
                term="dclsources"
                scheme="http://www.sap.com/adt/categories/acm/dclsources" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/adt/categories/acm/dclsources/properties"
                    template="/sap/bc/adt/acm/dcl/sources/{object_name}{?corrNr,lockHandle,version,accessMode,_action}" />
                <adtcomp:templateLink
                    rel="http://www.sap.com/adt/categories/acm/dclsources/source"
                    template="/sap/bc/adt/acm/dcl/sources/{object_name}/source/main{?corrNr,lockHandle,version}" />
            </adtcomp:templateLinks>
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>CDS Metadata Extensions</atom:title>
        <app:collection href="/sap/bc/adt/ddic/ddlx/sources">
            <atom:title>Metadata Extension</atom:title>
            <app:accept>application/vnd.sap.adt.ddic.ddlx.v1+xml</app:accept>
            <atom:category
                term="ddlxex"
                scheme="http://www.sap.com/wbobj/cds" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/wbobj/cds/ddlxex/properties"
                    template="/sap/bc/adt/ddic/ddlx/sources/{object_name}{?corrNr,lockHandle,version,accessMode,_action}" />
                <adtcomp:templateLink
                    rel="http://www.sap.com/wbobj/cds/ddlxex/source"
                    template="/sap/bc/adt/ddic/ddlx/sources/{object_name}/source/main{?corrNr,lockHandle,version}" />
            </adtcomp:templateLinks>
        </app:collection>
    </app:workspace>
    <app:workspace>
        <atom:title>Service Definitions</atom:title>
        <app:collection href="/sap/bc/adt/ddic/srvd/sources">
            <atom:title>Service Definition</atom:title>
            <app:accept>application/vnd.sap.adt.ddic.srvd.v1+xml</app:accept>
            <atom:category
                term="srvdsrv"
                scheme="http://www.sap.com/wbobj/raps" />
            <adtcomp:templateLinks xmlns:adtcomp="http://www.sap.com/adt/compatibility">
                <adtcomp:templateLink
                    rel="http://www.sap.com/wbobj/raps/srvdsrv/properties"
                    template="/sap/bc/adt/ddic/srvd/sources/{object_name}{?corrNr,lockHandle,version,accessMode,_action}" />
                <adtcomp:templateLink
                    rel="http://www.sap.com/wbobj/raps/srvdsrv/source"
                    template="/sap/bc/adt/ddic/srvd/sources/{object_name}/source/main{?corrNr,lockHandle,version}" />
            </adtcomp:templateLinks>
        </app:collection>
    </app:workspace>
</app:service>
